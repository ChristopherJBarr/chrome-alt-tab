{
	"manifest_version": 3,
	"name": "Chrome Alt+Tab (experimental)",
	"version": "0.5.1",
	"description": "Switch between Chrome tabs and Windows apps with a local Alt+Tab switcher.",
	"minimum_chrome_version": "120",
	"permissions": [
		"tabs",
		"nativeMessaging",
		"storage",
		"alarms"
	],
	"incognito": "not_allowed",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Chrome Alt+Tab: click to connect",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"key": "",
	"optional_host_permissions": [
		"<all_urls>"
	],
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
